[Unit]
Description=Аквапарк: синхронизация профиля игрока (маленький API)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/akvapark/repo/server/api/server.js
Environment=AKVA_API_PORT=8093
Environment=AKVA_API_DATA=/opt/akvapark/data/profiles
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/akvapark/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
